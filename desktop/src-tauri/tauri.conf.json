{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerOps",
  "version": "0.5.0",
  "identifier": "io.career-ops.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CareerOps",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/workspace-seed/": "workspace-seed/",
      "binaries/node-LICENSE": "licenses/Node.js-LICENSE.txt",
      "binaries/node-runtime.json": "runtime/node-runtime.json"
    },
    "externalBin": [
      "binaries/career-data",
      "binaries/careerops-node"
    ],
    "icon": [
      "icons/Assets.car",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hikarushane/career-ops-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOUYzQzg1NUM2Mjc3OUEKUldTYWQySmNoVHlmVTE0OS84eUEwcTR0OEcyZnBEUVZIWXBaeTBocFZkUThwcENQSnBoMFhQNnUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
