{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "career-ops desktop dashboard",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "store:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "/Volumes/**" },
        { "path": "/tmp/**" },
        { "path": "/private/**" }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "/Volumes/**" },
        { "path": "/tmp/**" },
        { "path": "/private/**" }
      ]
    },
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/career-data", "args": true, "sidecar": true }]
    }
  ]
}
