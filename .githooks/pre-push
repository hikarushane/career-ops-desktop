#!/usr/bin/env bash
# Pre-push hook: blocks unprepared pushes to main and unverified release tags.
# This hook ONLY verifies and blocks. It never commits, pushes, or modifies source.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

check_release_readiness() {
  node "$ROOT/scripts/release/validate-metadata.mjs" --prepared --production
}

while read -r local_ref local_oid remote_ref remote_oid; do
  remote_branch="${remote_ref#refs/heads/}"
  remote_tag="${remote_ref#refs/tags/}"

  # Gate: pushing to main
  if [ "$remote_branch" = "main" ]; then
    echo "Pre-push: verifying release readiness for main push..."
    check_release_readiness || exit 1
    echo "  Main push checks passed."
  fi

  # Gate both the Desktop tag namespace and the legacy v* namespace.
  if { [[ "$remote_tag" == desktop-v* ]] || [[ "$remote_tag" == v* ]]; } && [ "$remote_tag" != "$remote_ref" ]; then
    echo "Pre-push: verifying release tag $remote_tag..."
    check_release_readiness || exit 1

    expected_ver="${remote_tag#desktop-v}"
    expected_ver="${expected_ver#v}"
    pkg_ver=""
    pkg_ver=$(node -e "process.stdout.write(JSON.parse(require('fs').readFileSync('$ROOT/desktop/package.json','utf8')).version)")
    if [ "$pkg_ver" != "$expected_ver" ]; then
      echo "BLOCKED: Tag $remote_tag does not match fork version $pkg_ver"
      exit 1
    fi
    echo "  Release tag checks passed."
  fi
done

exit 0
